<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WillowWallet.Server</RootNamespace>
    <AssemblyName>WillowWalletServer</AssemblyName>
    <Product>WillowWallet Server</Product>
    <Company>Bytehawk Studio</Company>
    <Copyright>© 2026 Bytehawk Studio</Copyright>
    <!-- Releasing: change this and push to main. CI publishes Docker image + standalone builds as server-v<Version>. -->
    <Version>1.7.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\..\src\CoinPilot.Desktop\Assets\coinpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WillowWallet.Sync\WillowWallet.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WillowWallet.Server.Tests" />
  </ItemGroup>

</Project>
