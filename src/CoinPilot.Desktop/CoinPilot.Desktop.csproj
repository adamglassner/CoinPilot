<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the notification-area icon (bill reminders). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CoinPilot</RootNamespace>
    <AssemblyName>WillowWallet</AssemblyName>
    <Product>WillowWallet</Product>
    <Company>Bytehawk Studio</Company>
    <Authors>Bytehawk Studio</Authors>
    <Description>WillowWallet: budgets, transactions, accounts, debts, bills, goals, reports and tax documents.</Description>
    <!-- Releasing: change this and push to main. CI builds, tests and publishes GitHub Release v<Version>. -->
    <Version>1.0.2</Version>
    <Copyright>© 2026 Bytehawk Studio</Copyright>
    <!-- Lets the project at least restore/compile on non-Windows machines; the app itself is Windows-only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\coinpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish (build.ps1): bundle WPF's native DLLs into the exe too. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Keep WPF names unambiguous: Windows Forms types are referenced explicitly where needed. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\coinpilot.ico" />
    <Resource Include="Assets\coinpilot.png" />
  </ItemGroup>

</Project>
