<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 or later (Windows Hello needs the Windows SDK projection) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the notification-area icon (bill reminders). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CoinPilot</RootNamespace>
    <AssemblyName>WillowWallet</AssemblyName>
    <Product>WillowWallet</Product>
    <Company>Bytehawk Studio</Company>
    <Authors>Bytehawk Studio</Authors>
    <Description>WillowWallet: budgets, transactions, accounts, debts, bills, goals, reports and tax documents.</Description>
    <!-- Releasing: change this and push to main. CI builds, tests and publishes GitHub Release v<Version>. -->
    <Version>1.7.1</Version>
    <Copyright>© 2026 Bytehawk Studio</Copyright>
    <!-- Lets the project at least restore/compile on non-Windows machines; the app itself is Windows-only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\coinpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish (build.ps1): bundle WPF's native DLLs into the exe too. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Keep WPF names unambiguous: Windows Forms types are referenced explicitly where needed. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\WillowWallet.Sync\WillowWallet.Sync.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\coinpilot.ico" />
    <Resource Include="Assets\coinpilot.png" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
