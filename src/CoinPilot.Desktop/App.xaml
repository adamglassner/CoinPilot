<Application x:Class="CoinPilot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The main window is created in App.OnStartup (it may start hidden in the notification area). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] light/dark palette and [1] color theme layer are swapped at runtime (App.ApplyTheme) -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
