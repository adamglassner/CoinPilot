<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every key here must also exist in Dark.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F3F4EF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EEF2EC" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E5DE" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E7EAE3" />
    <SolidColorBrush x:Key="Brush.Track" Color="#ECEEE8" />
    <SolidColorBrush x:Key="Brush.Text" Color="#15201B" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#56635C" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#10000000" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#15201B" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#B9C4BD" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1E2B25" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#24332C" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#1E2B25" />

    <SolidColorBrush x:Key="Brush.Hero" Color="#15201B" />
    <SolidColorBrush x:Key="Brush.HeroText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeroMuted" Color="#B9C4BD" />
    <SolidColorBrush x:Key="Brush.HeroTrack" Color="#2C3B34" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#1F6B4F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3EFE8" />
    <SolidColorBrush x:Key="Brush.Mint" Color="#5FD39B" />
    <SolidColorBrush x:Key="Brush.BarMuted" Color="#C9D3CC" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#B86A12" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C2410C" />
    <SolidColorBrush x:Key="Brush.Positive" Color="#1F6B4F" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#15201B" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFF" />
</ResourceDictionary>
