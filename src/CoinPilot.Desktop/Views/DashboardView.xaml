<UserControl x:Class="CoinPilot.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- This month at a glance, from your transactions and budgets. -->
    <StackPanel>
        <!-- Header -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center" ToolTip="Add transaction (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                    <TextBlock Text="Add transaction" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Import_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Import a CSV, OFX or QFX statement from your bank or card.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                    <TextBlock Text="Import" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock x:Name="MonthText" Style="{StaticResource Muted}" FontSize="14" />
                <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Getting started (until dismissed or done) -->
        <ContentControl x:Name="WelcomeHost" Focusable="False" />

        <!-- Summary -->
        <UniformGrid Rows="1" Margin="0,0,-14,18">
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="GoBudgets_Click" ToolTip="Open Budgets">
                <Border Background="{DynamicResource Brush.Hero}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Left to spend" Foreground="{DynamicResource Brush.HeroMuted}" />
                        <TextBlock x:Name="LeftText" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.HeroText}" />
                        <TextBlock x:Name="LeftCaption" Foreground="{DynamicResource Brush.Mint}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="GoTransactions_Click" ToolTip="Open Transactions">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Spent this month" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="SpentText" Style="{StaticResource BigNumber}" />
                        <TextBlock x:Name="SpentCaption" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="GoTransactions_Click" ToolTip="Open Transactions">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Income" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="IncomeText" Style="{StaticResource BigNumber}" />
                        <TextBlock x:Name="IncomeCaption" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="GoTransactions_Click" ToolTip="Open Transactions">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Net this month" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="NetText" Style="{StaticResource BigNumber}" />
                        <TextBlock Text="Income minus spending" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
        </UniformGrid>

        <!-- Budgets + weekly spending -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="See all" Style="{StaticResource LinkButton}" Click="GoBudgets_Click" />
                        <TextBlock Text="Budgets" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="BudgetList" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="ChartMonthText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="Spending by week" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid x:Name="WeekChart" Height="214" VerticalAlignment="Bottom"
                          AutomationProperties.Name="Spending by week this month" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Upcoming bills + goals -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="All bills" Style="{StaticResource LinkButton}" Click="GoBills_Click" />
                        <TextBlock Text="Coming up" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="BillList" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="All goals" Style="{StaticResource LinkButton}" Click="GoGoals_Click" />
                        <TextBlock Text="Goals" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="GoalList" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recent transactions -->
        <Border Style="{StaticResource Card}" Padding="14,14,14,8">
            <StackPanel>
                <DockPanel Margin="8,0,8,6">
                    <Button DockPanel.Dock="Right" Content="View all" Style="{StaticResource LinkButton}" Click="GoTransactions_Click" />
                    <TextBlock Text="Recent transactions" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="RecentRows" />
                <ContentControl x:Name="RecentEmpty" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
