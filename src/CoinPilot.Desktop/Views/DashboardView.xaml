<UserControl x:Class="CoinPilot.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dashboard preview. All figures are sample data (see DashboardView.xaml.cs). -->
    <StackPanel>
        <!-- Header -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="240" Margin="0,0,10,0">
                    <TextBox Padding="32,7,8,7" IsReadOnly="True" Text="Search transactions" Cursor="Arrow"
                             Foreground="{DynamicResource Brush.TextMuted}"
                             AutomationProperties.Name="Search transactions"
                             PreviewMouseLeftButtonDown="Search_Click" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="11,0,0,0" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                </Grid>
                <Button Style="{StaticResource PrimaryButton}" Click="Soon_Click" Tag="Adding transactions">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Add transaction" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="MonthText" Style="{StaticResource Muted}" FontSize="14" />
                <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Preview notice -->
        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,0,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,12,0" />
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Preview." FontWeight="SemiBold" />
                    <Run Text="These numbers are sample data so you can see how CoinPilot will look. Tracking your own budgets, spending and goals is coming soon." />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Summary -->
        <UniformGrid Rows="1" Margin="0,0,-14,18">
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="Soon_Click" Tag="Your monthly budget">
                <Border Background="{DynamicResource Brush.Hero}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Left to spend" Foreground="{DynamicResource Brush.HeroMuted}" />
                        <TextBlock Text="$1,284.50" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.HeroText}" />
                        <TextBlock x:Name="DaysLeftText" Foreground="{DynamicResource Brush.Mint}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="Soon_Click" Tag="Spending details">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Spent this month" Style="{StaticResource Muted}" />
                        <TextBlock Text="$2,215.50" Style="{StaticResource BigNumber}" />
                        <TextBlock Text="of $3,500 budgeted" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="Soon_Click" Tag="Income tracking">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Income" Style="{StaticResource Muted}" />
                        <TextBlock Text="$4,100.00" Style="{StaticResource BigNumber}" />
                        <TextBlock Text="2 paychecks received" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="Soon_Click" Tag="Savings goals">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Saved toward goals" Style="{StaticResource Muted}" />
                        <TextBlock Text="$600.00" Style="{StaticResource BigNumber}" />
                        <TextBlock Text="Emergency fund · Trip" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Button>
        </UniformGrid>

        <!-- Budgets + weekly spending -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource LinkButton}" Click="Soon_Click" Tag="Editing budgets" />
                        <TextBlock Text="Budgets" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="BudgetList" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="ChartMonthText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="Spending by week" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid x:Name="WeekChart" Height="214" VerticalAlignment="Bottom"
                          AutomationProperties.Name="Weekly spending chart (sample data)" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Recent transactions -->
        <Border Style="{StaticResource Card}" Padding="22,20,22,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="View all" Style="{StaticResource LinkButton}" Click="ViewAll_Click" />
                    <TextBlock Text="Recent transactions" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="TxTable" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
