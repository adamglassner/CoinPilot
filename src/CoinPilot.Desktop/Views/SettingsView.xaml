<UserControl x:Class="CoinPilot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

        <!-- Appearance: this one actually works -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows (light or dark)" Checked="Theme_Checked" Tag="System" />
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" Tag="Light" />
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" Tag="Dark" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                    <TextBlock Text="SYNC &amp; MOBILE APP" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="Sign in to keep your budgets, transactions and goals in sync between this PC and the CoinPilot app on your phone." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Soon_Click" Tag="Signing in and sync" />
                    <Button Content="Get the mobile app" Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="The CoinPilot mobile app" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                    <TextBlock Text="BUDGET PREFERENCES" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="Currency, the day your budget month starts, your own categories and reminders." />
                <WrapPanel>
                    <Button Content="Currency" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Currency settings" />
                    <Button Content="Budget month" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Choosing when your budget month starts" />
                    <Button Content="Categories" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Editing categories" />
                    <Button Content="Reminders" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Bill and budget reminders" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="YOUR DATA" Style="{StaticResource SectionLabel}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                           Text="Your transactions, budgets, accounts, debts, bills and goals are saved on this PC, in this folder:" />
                <TextBlock x:Name="DataFolderText" FontFamily="Consolas" FontSize="12.5" Margin="0,0,0,12" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Open data folder" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OpenData_Click" />
                    <Button Content="Import statements (soon)" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Importing bank statements" />
                    <Button Content="Back up (soon)" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="Soon_Click" Tag="Backups" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                           Text="To export transactions, use Export on the Transactions page." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/coinpilot.png" Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="© 2026 Bytehawk Studio" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="Everything except sync with the mobile app works and is saved on this PC. Updates arrive through the Bytehawk Studio Launcher." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
