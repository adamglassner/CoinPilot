<UserControl x:Class="CoinPilot.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CoinPilot.Views">
    <StackPanel>
        <!-- Title + month -->
        <DockPanel Margin="0,0,0,22">
            <v:MonthSwitcher x:Name="Month" DockPanel.Dock="Right" />
            <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Transactions" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Every dollar in and out, in one list." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Search + actions -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="Import_Click" Margin="0,0,8,0"
                        ToolTip="Importing bank statements is coming soon.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0"
                        ToolTip="Save this month's transactions as a CSV file (opens in Excel).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Add transaction" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid HorizontalAlignment="Left" Width="340">
                <TextBox x:Name="SearchBox" Padding="32,7,8,7" TextChanged="Search_Changed"
                         AutomationProperties.Name="Search transactions" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="11,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search payee, category, account or note" Margin="34,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Month totals -->
        <UniformGrid Rows="1" Margin="0,0,-14,18">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Spent" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="SpentText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Income" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="IncomeText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Net (income − spent)" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="NetText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Transactions" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- List -->
        <Border Style="{StaticResource Card}" Padding="14,6,14,6">
            <StackPanel>
                <Grid x:Name="HeaderRow" Margin="0,8,0,8" />
                <StackPanel x:Name="Rows" />
                <ContentControl x:Name="EmptyHost" Focusable="False" />
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,10,0,0"
                   Text="Click a transaction to edit or delete it. Saved on this PC." />
    </StackPanel>
</UserControl>
