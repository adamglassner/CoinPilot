<UserControl x:Class="CoinPilot.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CoinPilot.Views">
    <StackPanel>
        <!-- Title + month -->
        <DockPanel Margin="0,0,0,22">
            <v:MonthSwitcher x:Name="Month" DockPanel.Dock="Right" />
            <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Transactions" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Every dollar in and out, in one list." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Search + actions -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="FilterButton" Style="{StaticResource GhostButton}" Click="Filters_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock x:Name="FilterLabel" Text="Filters" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Import_Click" Margin="0,0,8,0"
                        ToolTip="Import a CSV, OFX or QFX statement from your bank or card.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0"
                        ToolTip="Save what's shown as a CSV file (opens in Excel).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Add_Click" ToolTip="Add transaction (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Add transaction" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid HorizontalAlignment="Left" Width="340">
                <TextBox x:Name="SearchBox" Padding="32,7,8,7" TextChanged="Search_Changed"
                         AutomationProperties.Name="Search transactions" ToolTip="Search (Ctrl+F)" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search payee, category, tag, note or amount" Margin="34,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Filters -->
        <Border x:Name="FilterBar" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear filters" Style="{StaticResource LinkButton}" Click="ClearFilters_Click"
                        VerticalAlignment="Bottom" Margin="0,0,0,4" />
                <UniformGrid Rows="1" Margin="0,0,12,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Type" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <ComboBox x:Name="TypeFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Type" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Category" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <ComboBox x:Name="CategoryFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Category" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Account" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <ComboBox x:Name="AccountFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Account" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Tag" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <ComboBox x:Name="TagFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Tag" />
                    </StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>

        <!-- Month totals -->
        <UniformGrid Rows="1" Margin="0,6,-14,18">
            <Border Background="{DynamicResource Brush.Hero}" CornerRadius="14" Padding="20" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Spent" Foreground="{DynamicResource Brush.HeroMuted}" />
                    <TextBlock x:Name="SpentText" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Brush.HeroText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Income" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="IncomeText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Net (income − spent)" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="NetText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock x:Name="CountLabel" Text="Transactions" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- List -->
        <Border Style="{StaticResource Card}" Padding="14,6,14,6">
            <StackPanel>
                <Grid x:Name="HeaderRow" Margin="0,8,0,8" />
                <StackPanel x:Name="Rows" />
                <ContentControl x:Name="EmptyHost" Focusable="False" />
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,10,0,0"
                   Text="Click a transaction to edit or delete it. Ctrl+N adds one from anywhere." />
    </StackPanel>
</UserControl>
