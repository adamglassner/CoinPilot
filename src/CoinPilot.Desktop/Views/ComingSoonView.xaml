<UserControl x:Class="CoinPilot.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generic page for any section that isn't built yet. DataContext = ModuleInfo. -->
    <StackPanel>
        <!-- Title -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0"
                    Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="24"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SoonPill}" Margin="12,0,0,0">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Tagline}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Action bar (every button just says "coming soon") -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Filters" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Filters" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Export" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Soon_Click" Tag="{Binding PrimaryAction}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PrimaryAction}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid HorizontalAlignment="Left" Width="340">
                <TextBox Padding="32,7,8,7" IsReadOnly="True" Text="Search…" Cursor="Arrow"
                         Foreground="{DynamicResource Brush.TextMuted}"
                         AutomationProperties.Name="Search"
                         PreviewMouseLeftButtonDown="Search_Click" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="11,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Summary tiles -->
        <ItemsControl x:Name="KpiPanel" ItemsSource="{Binding Kpis}" Margin="0,0,-14,18" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Text="—" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Placeholder table -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
            <Grid x:Name="TableHost" MinHeight="260">
                <!-- Skeleton grid is inserted here from code-behind -->
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28,20" Margin="0,40,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Nothing here yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" is coming soon to WillowWallet." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- About + planned features -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ABOUT THIS SECTION" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PLANNED FEATURES" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Features}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,14,4">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,3,9,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
