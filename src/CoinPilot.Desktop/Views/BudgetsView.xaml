<UserControl x:Class="CoinPilot.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CoinPilot.Views">
    <StackPanel>
        <!-- Title + month -->
        <DockPanel Margin="0,0,0,22">
            <v:MonthSwitcher x:Name="Month" DockPanel.Dock="Right" />
            <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Budgets" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Give every dollar a job and see how each category is doing." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Actions -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Style="{StaticResource GhostButton}" Click="Copy_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Copy last month" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Template_Click" Margin="0,0,8,0"
                        ToolTip="Create budgets with 50/30/20, zero-based or starter amounts.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Use a template" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewButton" Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="New budget" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="AssignText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <!-- Month totals -->
        <UniformGrid Rows="1" Margin="0,0,-14,18">
            <Border Background="{DynamicResource Brush.Hero}" CornerRadius="14" Padding="20" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Left to spend" Foreground="{DynamicResource Brush.HeroMuted}" />
                    <TextBlock x:Name="LeftText" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Brush.HeroText}" />
                    <Grid x:Name="LeftBarHost" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Budgeted" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="BudgetedText" Style="{StaticResource BigNumber}" />
                    <TextBlock x:Name="CarryText" Style="{StaticResource Muted}" FontSize="12.5" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Spent in budgets" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="SpentText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Over budget" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="OverText" Style="{StaticResource BigNumber}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Budgets -->
        <Border Style="{StaticResource Card}" Padding="14,6,14,6" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel x:Name="Rows" />
                <ContentControl x:Name="EmptyHost" Focusable="False" />
            </StackPanel>
        </Border>

        <!-- Spending with no budget -->
        <Border x:Name="UnbudgetedCard" Style="{StaticResource Card}" Padding="22,18,22,12">
            <StackPanel>
                <TextBlock Text="Spending without a budget" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="UnbudgetedIntro" Style="{StaticResource Muted}" Margin="0,4,0,8" />
                <StackPanel x:Name="UnbudgetedRows" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
