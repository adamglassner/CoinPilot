<Window x:Class="CoinPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoinPilot"
        Icon="pack://application:,,,/Assets/coinpilot.ico"
        Width="1360" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="16,22,16,16">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
                    <Image Source="pack://application:,,,/Assets/coinpilot.png" Width="34" Height="34" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="CoinPilot" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.SidebarText}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Bottom: sync status, theme, settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource Brush.SidebarCard}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10"
                            ToolTip="Syncing between your PC and the CoinPilot mobile app is coming soon.">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.SidebarMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sync coming soon" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}" />
                            </StackPanel>
                            <TextBlock Text="For now everything stays on this PC. The mobile app and sync are on the way."
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{DynamicResource Brush.SidebarMuted}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarButton}" Click="Theme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock x:Name="ThemeLabel" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock Text="Settings" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation (scrolls if the window is short) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,8">
                <ItemsControl x:Name="NavList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         ToolTip="{Binding Tagline}"
                                         AutomationProperties.Name="{Binding Title}"
                                         Checked="Nav_Checked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="36,30,36,30">
                <ContentControl x:Name="PageHost" MaxWidth="1240" Focusable="False" />
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="18,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"
                               Text="Mobile app and sync: coming soon" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11.5" />
                </DockPanel>
            </Border>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.RowSpan="2" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,48"
                    Background="{DynamicResource Brush.ToastBg}" CornerRadius="12" Padding="16,12" MaxWidth="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Mint}" />
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
